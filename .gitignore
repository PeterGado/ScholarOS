# Stray artifacts from running backend/frontend tooling with the wrong working directory
# (e.g. `npm install` or a Python process launched from the repo root instead of its own
# subproject) - real lockfiles/databases live under backend/ and frontend/, never here.
/package-lock.json
/scholaros.db
/scholaros.db-shm
/scholaros.db-wal
/node_modules/

# Local Claude Code scratch space, not part of the app itself.
/scratch/

# A large third-party frontend-skills collection pulled in locally for Claude Code's own use -
# not part of this app, unlike the rest of the already-tracked .claude/Skills/ catalog.
/.claude/Skills/frontend/
