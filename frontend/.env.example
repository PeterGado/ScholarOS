# Base URL of the running ScholarOS backend (FastAPI/uvicorn). No trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google Sign-In (2026-09-20): the OAuth Client ID from Google Cloud Console. Not a secret -
# safe to commit/expose; leave blank to hide the Google sign-in button entirely.
VITE_GOOGLE_CLIENT_ID=

# Bot protection on registration (2026-10-11): the Cloudflare Turnstile site key from your
# Cloudflare dashboard. Not a secret (the matching secret key is backend-only, see
# backend/.env.example's TURNSTILE_SECRET_KEY) - leave blank to disable the widget entirely;
# registration works exactly as before with no Turnstile check at all.
VITE_TURNSTILE_SITE_KEY=
