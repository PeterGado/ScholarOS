# ScholarOS backend - environment configuration
# MVP defaults per ADR-004 (Storage and Memory Strategy): SQLite structured core, local filesystem object store.
# PostgreSQL and S3-compatible object storage are also supported (see README.md "Database
# (SQLite / PostgreSQL)" and "Object Storage") - both selected by configuration, never a code
# change. Every setting below is optional unless noted - all have working defaults in
# app/core/config.py; this file only needs the ones your deployment actually uses.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./scholaros.db
# Postgres-only, Row-Level Security rollout: the restricted app role's own connection string,
# used instead of DATABASE_URL once cut over to a non-owner DB role. Leave unset until then -
# falls back to DATABASE_URL, and Alembic always uses DATABASE_URL regardless of this.
APP_DATABASE_URL=
STORAGE_ROOT=./data/documents
# No limit existed before this (2026-09-19 security pass) - every upload route read an entire
# file into memory unconditionally. 20MB (default) comfortably covers real research documents.
MAX_UPLOAD_SIZE_BYTES=20971520

# Object storage backend: "filesystem" (default, uses STORAGE_ROOT above) or "s3" (any
# S3-compatible endpoint - AWS S3, Cloudflare R2, a local mock). Only read when
# STORAGE_BACKEND=s3.
STORAGE_BACKEND=filesystem
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Authentication Boundary (ADR-010) - the one pre-provisioned account.
# AUTH_PASSWORD_HASH is a bcrypt HASH, never a plaintext password - see README.md
# "Authentication Setup" for how to generate one. Never commit real values here or anywhere
# in source control; this file only ever holds placeholders.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
# Self-service registration (ADR-011): when set, POST /auth/register requires a matching
# invite_code - a temporary friends-testing gate. Leave unset for open registration.
REGISTRATION_INVITE_CODE=
# Google Sign-In (2026-09-20): the OAuth Client ID from Google Cloud Console. Not a secret (also
# embedded in the frontend as VITE_GOOGLE_CLIENT_ID) - unset means the feature is off.
GOOGLE_OAUTH_CLIENT_ID=

# Transactional email (2026-10-06, password reset + email verification) via Resend. Unset means
# both features fail closed (EmailSendError) rather than silently pretending to send.
RESEND_API_KEY=
PASSWORD_RESET_FROM_ADDRESS=ScholarOS <onboarding@resend.dev>
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
# Where the frontend is deployed - password reset and email verification links point here, since
# the backend has no other way to know. Must be set explicitly per environment.
FRONTEND_BASE_URL=http://localhost:5173

# AI Provider Abstraction (ADR-002) - the default concrete provider is Google Gemini via the
# native google-genai SDK ("google_genai"); an OpenAI-compatible HTTP shim ("openai_compatible")
# remains available via AI_PROVIDER. AI_API_KEY is a secret - never commit a real value here.
# AI_BASE_URL is only read by the "openai_compatible" provider.
AI_PROVIDER=google_genai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Multi-key failover (2026-09-30): a JSON array of keys - when set, AI_API_KEY is unused and the
# provider factory wraps one provider per key in a FailoverProvider instead. Leave empty for a
# single-key deployment.
AI_API_KEYS=[]
# Per-key request pacing for the multi-key path above - calls per rolling 60s window per key.
AI_MAX_CALLS_PER_MINUTE_PER_KEY=10
AI_MODEL=gemini-3.7-flash
AI_EMBEDDING_MODEL=gemini-embedding-001
# Generation temperature - lower reduces rambling/drift on grounded academic writing without
# going fully deterministic. Leave unset (empty) to use the provider SDK's own default.
AI_TEMPERATURE=0.4
# Per-call output cap, so a single generate() call can't run unbounded. Leave unset for no cap.
AI_MAX_OUTPUT_TOKENS=4096
# Cumulative per-user daily cap (ADR-011's deferred per-user quota item) - bounds total cost, not
# just rate. Set to a blank value to disable entirely.
AI_DAILY_TOKEN_CAP_PER_USER=2000000
# Draft -> critique -> revise, ~3x the AI calls/latency per chat reply for a quality gain -
# already accepted at this project's scale. Set to false as a zero-code-change rollback.
AI_ENABLE_MULTI_PASS_GENERATION=true

# Frontend CORS (2026-09-16): a JSON array of allowed origins. Defaults cover the Vite dev
# server; override for any other deployment origin (e.g. the real deployed frontend domain).
CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Sentry error tracking (2026-09-21). Unset means the feature is off entirely (no-op, not an
# error) - this is write-only (a DSN can't be used to read data out of Sentry) but still treated
# like other config here.
SENTRY_DSN=

# Work Item queue tuning (2026-09-30, concurrent-load planning). Defaults are conservative
# starting points for ~100-300 concurrent users - see app/core/config.py for the full reasoning
# behind each number; safe to leave unset unless you're observing a real bottleneck.
QUEUE_STALE_THRESHOLD_SECONDS=600
WORK_ITEM_WORKER_COUNT=3
WEB_ENGINE_POOL_SIZE=10
WEB_ENGINE_MAX_OVERFLOW=15
WORKER_ENGINE_POOL_SIZE=10
WORKER_ENGINE_MAX_OVERFLOW=10
